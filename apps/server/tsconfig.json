{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true
  },
  "include": ["src"],
  // Workers-only modules (`*.worker.ts`) are typechecked/bundled separately
  // (tsconfig.worker.json + wrangler). Excluded here so Node globals and Workers
  // globals never collide.
  "exclude": ["src/**/*.worker.ts"]
}
