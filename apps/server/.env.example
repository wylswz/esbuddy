# Copy to apps/server/.env and adjust for local development.

# Storage: 'sqlite' (default). 'd1' / 'pg' are future drivers.
DB_KIND=sqlite
# DB_PATH=./.db/esbuddy.sqlite

# Auth — JWT signing secret. Required in production (dev falls back to a dev secret).
JWT_SECRET=esbuddy-dev-secret

# Dev mode — enables /api/auth/dev-login (defaults to off when NODE_ENV=production)
DEV_MODE=true

# Google OAuth (server-side flow)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback

# Frontend URL used for the post-login redirect
# FRONTEND_URL=http://localhost:5173

# Built SPA assets path (defaults to apps/web/dist; only for single deployment)
# WEB_DIST_PATH=

# HTTP port
PORT=8787

# Resource limits (optional; defaults shown)
# MAX_WORKSPACES_PER_USER=10
# MAX_CANVASES_PER_WORKSPACE=100
# MAX_MEMBERS_PER_WORKSPACE=50
