{
  // Typechecks the Cloudflare tests (test/cf) with Workers globals plus the
  // `cloudflare:test` module from @cloudflare/vitest-pool-workers — never Node
  // globals (they collide, see tsconfig.test.json). Also what the IDE uses for
  // these files. Run via `pnpm test:typecheck`.
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers"],
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["./**/*.ts", "../env.d.ts"]
}
