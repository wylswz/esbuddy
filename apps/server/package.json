{
  "name": "@esbuddy/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.node.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.node.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.node.ts",
    "db:migrate:d1:local": "wrangler d1 migrations apply esbuddy --local",
    "db:migrate:d1": "wrangler d1 migrations apply esbuddy --remote",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@esbuddy/sdk": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.6.16",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "wrangler": "^4.129.0"
  }
}
